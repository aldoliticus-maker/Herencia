<script>

// Actualiza el campo según la modalidad seleccionada.

const modalidad = document.getElementById("modalidad");
const etiqueta = document.getElementById("detalle-label");
const detalle = document.getElementById("detalle");

modalidad.addEventListener("change", function () {

    if (this.value === "presencial") {

        etiqueta.textContent = "Aula";
        detalle.placeholder = "Ej. Aula 203";

    } else if (this.value === "en-linea") {

        etiqueta.textContent = "Plataforma";
        detalle.placeholder = "Ej. Moodle";

    } else {

        etiqueta.textContent = "Aula o plataforma";
        detalle.placeholder = "Ej. Aula 203 o Moodle";

    }

});

</script>

