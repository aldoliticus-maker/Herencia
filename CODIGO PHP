
<?php

// ============================================
// CLASE BASE: ESTUDIANTE
// ============================================

class Estudiante {

    protected $nombre;
    protected $matricula;
    protected $calificacion;

    // Constructor de la clase base.
    public function __construct($nombre, $matricula, $calificacion) {
        $this->nombre = $nombre;
        $this->matricula = $matricula;
        $this->calificacion = $calificacion;
    }

    // Determina si el estudiante aprobó o reprobó.
    public function obtenerEstado() {
        return $this->calificacion >= 70 ? "Aprobado" : "Reprobado";
    }

    // Método que será sobrescrito por las clases derivadas.
    public function obtenerModalidad() {
        return "No especificada";
    }

    // Obtiene la información general del estudiante.
    public function obtenerInformacion() {
        return [
            "nombre" => $this->nombre,
            "matricula" => $this->matricula,
            "calificacion" => $this->calificacion,
            "estado" => $this->obtenerEstado(),
            "modalidad" => $this->obtenerModalidad()
        ];
    }
}


// ============================================
// CLASE DERIVADA: ESTUDIANTE PRESENCIAL
// ============================================

class EstudiantePresencial extends Estudiante {

    private $aula;

    public function __construct($nombre, $matricula, $calificacion, $aula) {

        // Llama al constructor de la clase base.
        parent::__construct($nombre, $matricula, $calificacion);

        $this->aula = $aula;
    }

    // Sobrescribe el método de la clase base.
    public function obtenerModalidad() {
        return "Presencial";
    }

    // Método exclusivo de esta clase.
    public function obtenerAula() {
        return $this->aula;
    }

    public function obtenerInformacion() {

        $datos = parent::obtenerInformacion();

        $datos["detalle"] = "Aula: " . $this->aula;

        return $datos;
    }
}


// ============================================
// CLASE DERIVADA: ESTUDIANTE EN LÍNEA
// ============================================

class EstudianteEnLinea extends Estudiante {

    private $plataforma;

    public function __construct($nombre, $matricula, $calificacion, $plataforma) {

        // Llama al constructor de la clase base.
        parent::__construct($nombre, $matricula, $calificacion);

        $this->plataforma = $plataforma;
    }

    // Sobrescribe el método de la clase base.
    public function obtenerModalidad() {
        return "En línea";
    }

    // Método exclusivo de esta clase.
    public function obtenerPlataforma() {
        return $this->plataforma;
    }

    public function obtenerInformacion() {

        $datos = parent::obtenerInformacion();

        $datos["detalle"] = "Plataforma: " . $this->plataforma;

        return $datos;
    }
}


// ============================================
// PROGRAMA PRINCIPAL
// ============================================

// Guarda los registros durante la sesión del navegador.
session_start();

if (!isset($_SESSION["estudiantes"])) {
    $_SESSION["estudiantes"] = [];
}

$mensaje = "";

// Comprueba si se envió el formulario.
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $nombre = trim($_POST["nombre"] ?? "");
    $calificacion = $_POST["calificacion"] ?? "";
    $modalidad = $_POST["modalidad"] ?? "";
    $detalle = trim($_POST["detalle"] ?? "");

    // Validación de los datos.
    if (
        $nombre === "" ||
        !is_numeric($calificacion) ||
        $calificacion < 0 ||
        $calificacion > 100 ||
        $detalle === ""
    ) {

        $mensaje = "Completa todos los campos correctamente.";

    } elseif (!in_array($modalidad, ["presencial", "en-linea"], true)) {

        $mensaje = "Selecciona una modalidad válida.";

    } else {

        // Genera una matrícula automáticamente.
        $matricula = "EST" . date("ymdHis") . random_int(10, 99);

        // Instancia la clase derivada correspondiente.
        if ($modalidad === "presencial") {

            $estudiante = new EstudiantePresencial(
                $nombre,
                $matricula,
                $calificacion,
                $detalle
            );

        } else {

            $estudiante = new EstudianteEnLinea(
                $nombre,
                $matricula,
                $calificacion,
                $detalle
            );

        }

        // Obtiene y guarda la información del estudiante.
        $_SESSION["estudiantes"][] = $estudiante->obtenerInformacion();

        $mensaje = "¡Estudiante registrado correctamente!";
    }
}

// Permite limpiar los registros de la sesión.
if (isset($_POST["limpiar"])) {
    $_SESSION["estudiantes"] = [];
    $mensaje = "Se eliminaron los registros de esta sesión.";
}

// Función para proteger la salida HTML.
function escapar($valor) {
    return htmlspecialchars((string)$valor, ENT_QUOTES, "UTF-8");
}

